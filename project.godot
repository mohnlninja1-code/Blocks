; Blocks — original voxel sandbox project
; Engine target pinned by docs and CI: Godot 4.7.2 stable.
config_version=5

[application]
config/name="Blocks: Voxel Frontier"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A seed-driven, persistent voxel survival sandbox."
run/max_fps=60

[autoload]
BlockRegistry="*res://scripts/block_registry.gd"
SaveStore="*res://scripts/save_store.gd"
SoundBank="*res://scripts/sound_bank.gd"
RecipeRegistry="*res://scripts/recipe_registry.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.31, 0.48, 0.68, 1)

[physics]
3d/default_gravity=24.0
